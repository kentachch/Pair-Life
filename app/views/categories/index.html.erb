<% content_for(:title) { "カテゴリ" } %>

<div class="min-h-screen bg-gray-50">
  <main class="mx-auto max-w-3xl px-4 py-6 sm:py-12">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">カテゴリ</h1>
        <p class="mt-1 text-sm text-gray-500">支出が登録されているカテゴリは削除できません。</p>
      </div>
      <%= link_to "＋ 追加", new_category_path,
          class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700" %>
    </div>

    <% if @categories.any? %>
      <%# スマホでは2列、広い画面では3列のカードで並べる %>
      <ul class="mt-6 grid grid-cols-2 gap-3 sm:mt-8 sm:grid-cols-3 sm:gap-4">
        <% @categories.each do |category| %>
          <% expense_count = @expense_counts.fetch(category.id, 0) %>

          <li class="flex flex-col items-center rounded-xl bg-white p-4 text-center shadow-sm sm:p-5">
            <%= category_icon(category, size: :lg) %>
            <p class="mt-3 font-medium text-gray-900"><%= category.name %></p>
            <p class="mt-1 text-xs text-gray-500">支出 <%= expense_count %> 件</p>

            <div class="mt-4 flex gap-2">
              <%= link_to "編集", edit_category_path(category),
                  class: "rounded-lg border px-3 py-2 text-sm hover:bg-gray-100" %>
              <%# 支出があるカテゴリは削除できないので、ボタンを押せない状態で表示する %>
              <% if expense_count.zero? %>
                <%= button_to "削除", category_path(category), method: :delete,
                    form: { data: { turbo_confirm: "「#{category.name}」を削除しますか？" } },
                    class: "rounded-lg border border-red-200 px-3 py-2 text-sm text-red-600 hover:bg-red-50" %>
              <% else %>
                <span class="cursor-not-allowed rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-300"
                      title="支出が登録されているため削除できません">削除</span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-8 rounded-xl bg-white px-6 py-8 text-center text-sm text-gray-500 shadow-sm">カテゴリがありません。</p>
    <% end %>

    <div class="mt-8 text-center">
      <%= link_to "ホームへ戻る", root_path, class: "text-sm font-semibold text-blue-600 hover:underline" %>
    </div>
  </main>
</div>
