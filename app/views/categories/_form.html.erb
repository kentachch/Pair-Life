<%# new と edit で共用するフォーム。category が新規か既存かで送信先が自動で切り替わる %>
<%= form_with model: category do |f| %>
  <%# 入力エラーがあるときだけ、エラーメッセージを表示する %>
  <% if category.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-700">
      <ul class="list-inside list-disc">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "カテゴリ名", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, placeholder: "例：食費",
        class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none" %>
  </div>

  <%= f.submit "保存する",
      class: "mt-6 w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700" %>
<% end %>
