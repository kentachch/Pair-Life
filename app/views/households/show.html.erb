<% content_for(:title) { @household.name } %>

<div class="min-h-screen bg-gray-50">
  <main class="mx-auto max-w-md px-4 py-6 sm:py-12">
    <h1 class="text-2xl font-bold text-gray-900"><%= @household.name %></h1>

    <div class="mt-8 rounded-xl bg-white p-6 shadow-sm">
      <h2 class="font-semibold text-gray-900 flex"><%= lucide_icon("users", size: 20) %> メンバー</h2>
      <ul class="mt-3 divide-y">
        <% @household.users.each do |user| %>
          <li class="py-2 text-gray-700">
            <span>👤 <%= user.name %></span>
            <% if user == current_user %>
              <span class="text-sm text-gray-400">(あなた)</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <%# 招待コードは2人そろうと nil になるので、そのときは表示しない %>
    <% if @household.invite_code.present? %>
      <div class="mt-6 rounded-xl bg-white p-6 shadow-sm">
        <h2 class="font-semibold text-gray-900">招待コード</h2>
        <p class="mt-1 text-sm text-gray-500">
          パートナーにこのコードを伝えて、参加してもらいましょう。
        </p>
        <%# コードと同じ高さのコピーボタンを横に並べる %>
        <div class="mt-4 flex items-stretch gap-2" data-controller="clipboard">
          <p class="flex-1 rounded-lg bg-gray-100 px-4 py-3 text-center font-mono text-2xl font-bold tracking-widest text-gray-900"
             data-clipboard-target="source">
            <%= @household.invite_code %>
          </p>
          <button type="button"
                  title="招待コードをコピー"
                  class="flex w-32 shrink-0 cursor-pointer items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-4 text-sm font-semibold text-white hover:bg-blue-700 disabled:bg-blue-400"
                  data-action="click->clipboard#copy">
            <%= lucide_icon("copy", size: 16) %>
            コピー
          </button>
        </div>
      </div>
    <% end %>

    <div class="mt-8 text-center">
      <%= link_to "← ホームへ", root_path, class: "text-sm font-semibold text-blue-600 hover:underline" %>
    </div>
  </main>
</div>
