<% content_for(:title) { "支出を追加" } %>

<div class="min-h-screen bg-gray-50">
  <main class="mx-auto max-w-md px-4 py-6 sm:py-12">
    <h1 class="text-2xl font-bold text-gray-900">支出を追加</h1>

    <div class="mt-8 rounded-xl bg-white p-6 shadow-sm">
      <%= render "form", expense: @expense %>
    </div>

    <div class="mt-6 text-center">
      <%= link_to "支出一覧へ戻る", expenses_path, class: "text-sm font-semibold text-blue-600 hover:underline" %>
    </div>
  </main>
</div>
