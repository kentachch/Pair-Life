<% content_for(:title) { "支出一覧" } %>

<div class="min-h-screen bg-gray-50">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">支出一覧</h1>
      <%= link_to "＋ 支出を追加", new_expense_path,
          class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700" %>
    </div>

    <div class="mt-8 overflow-hidden rounded-xl bg-white shadow-sm">
      <% if @expenses.any? %>
        <ul class="divide-y">
          <% @expenses.each do |expense| %>
            <li class="flex flex-wrap items-center justify-between gap-3 px-6 py-4">
              <div>
                <p class="font-medium text-gray-900">
                  <%= expense.category.name %>
                  <% if expense.memo.present? %>
                    <span class="text-sm font-normal text-gray-500">・<%= expense.memo %></span>
                  <% end %>
                </p>
                <p class="text-sm text-gray-500">
                  <%= expense.spent_on.strftime("%Y/%m/%d") %> ・ <%= expense.payer.name %> が支払い
                </p>
              </div>

              <div class="flex items-center gap-3">
                <p class="font-semibold text-gray-900">
                  <%= number_to_currency(expense.amount, unit: "¥", precision: 0) %>
                </p>
                <%= link_to "編集", edit_expense_path(expense),
                    class: "rounded border px-3 py-1 text-sm hover:bg-gray-100" %>
                <%= button_to "削除", expense_path(expense), method: :delete,
                    form: { data: { turbo_confirm: "この支出を削除しますか？" } },
                    class: "rounded border border-red-200 px-3 py-1 text-sm text-red-600 hover:bg-red-50" %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-6 py-8 text-center text-sm text-gray-500">まだ支出が登録されていません。</p>
      <% end %>
    </div>

    <div class="mt-8 text-center">
      <%= link_to "ホームへ戻る", root_path, class: "text-sm font-semibold text-blue-600 hover:underline" %>
    </div>
  </main>
</div>
