<% content_for(:title) { "支出一覧" } %>

<div class="min-h-screen bg-gray-50">
  <main class="mx-auto max-w-3xl px-4 py-6 sm:py-12">

    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">支出一覧</h1>
      <%= link_to "＋ 支出を追加", new_expense_path,
          class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700" %>
    </div>

    <!-- 月の切り替えと、その月の合計 -->
    <div class="mt-6 rounded-xl bg-white p-4 shadow-sm sm:mt-8 sm:p-6">

      <div class="flex items-center justify-between gap-2">
        <%= link_to "◀ #{@month.prev_month.strftime('%-m月')}",
            expenses_path(month: @month.prev_month.strftime("%Y-%m")),
            class: "rounded-lg border px-3 py-2 text-sm text-gray-700 hover:bg-gray-100" %>

        <h2 class="text-lg font-semibold text-gray-900"><%= @month.strftime("%Y年%-m月") %></h2>

        <%= link_to "#{@month.next_month.strftime('%-m月')} ▶",
            expenses_path(month: @month.next_month.strftime("%Y-%m")),
            class: "rounded-lg border px-3 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
      </div>

      <p class="mt-4 text-center text-sm text-gray-500">支出の合計</p>
      <p class="text-center text-3xl font-bold text-gray-900">
        <%= number_to_currency(@monthly_total, unit: "¥", precision: 0) %>
      </p>

      <div class="mt-6 border-t pt-5">
        <%= render "shared/payer_totals", payer_totals: @payer_totals %>
      </div>
    </div>

    <div class="mt-6 overflow-hidden rounded-xl bg-white shadow-sm">
      <% if @expenses.any? %>

        <ul class="divide-y">
          <% @expenses.each do |expense| %>
            <%# スマホでも1行に収まるよう、左に内容・右に金額と操作ボタンを置く %>
            <li class="flex items-center gap-3 px-4 py-4 sm:px-6">
              <%= category_icon(expense.category) %>

              <%# min-w-0 と truncate で、長いメモは「…」で省略して横にはみ出さないようにする %>
              <div class="min-w-0 flex-1">
                <p class="truncate font-medium text-gray-900">
                  <%= expense.category.name %>
                  <% if expense.memo.present? %>
                    <span class="text-sm font-normal text-gray-500">（<%= expense.memo %>）</span>
                  <% end %>
                </p>
                <p class="truncate text-sm text-gray-500">
                  <%= expense.spent_on.strftime("%-m/%-d") %> 支払い： 👤 <%= expense.payer.name %>
                </p>
              </div>

              <div class="flex shrink-0 flex-col items-end gap-1 sm:flex-row sm:items-center sm:gap-3">
                <p class="font-semibold text-gray-900">
                  <%= number_to_currency(expense.amount, unit: "¥", precision: 0) %>
                </p>
                <%# 操作ボタンはアイコンにして、指で押しやすい大きさ(36px)にする %>
                <div class="flex gap-1">
                  <%= link_to edit_expense_path(expense), title: "編集", "aria-label": "編集",
                      class: "flex h-9 w-9 items-center justify-center rounded-lg border text-gray-600 hover:bg-gray-100" do %>
                    <%= lucide_icon("pencil", size: 16) %>
                  <% end %>
                  <%= button_to expense_path(expense), method: :delete, title: "削除", "aria-label": "削除",
                      form: { data: { turbo_confirm: "この支出を削除しますか？" } },
                      class: "flex h-9 w-9 items-center justify-center rounded-lg border border-red-200 text-red-600 hover:bg-red-50" do %>
                    <%= lucide_icon("trash-2", size: 16) %>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-6 py-8 text-center text-sm text-gray-500"><%= @month.strftime("%-m月") %>の支出はまだありません。</p>
      <% end %>
    </div>

    <div class="mt-8 text-center">
      <%= link_to "ホームへ戻る", root_path, class: "text-sm font-semibold text-blue-600 hover:underline" %>
    </div>
  </main>
</div>
