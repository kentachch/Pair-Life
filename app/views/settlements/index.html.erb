<% content_for(:title) { "精算" } %>

<div class="min-h-screen bg-gray-50">
  <main class="mx-auto max-w-3xl px-4 py-6 sm:py-12">
    <h1 class="text-2xl font-bold text-gray-900">精算</h1>

    <!-- 月の切り替えと、その月の支出 -->
    <div class="mt-6 rounded-xl bg-white p-4 shadow-sm sm:p-6">
      <div class="flex items-center justify-between gap-2">
        <%= link_to "◀ #{@month.prev_month.strftime('%-m月')}",
            settlements_path(month: @month.prev_month.strftime("%Y-%m")),
            class: "rounded-lg border px-3 py-2 text-sm text-gray-700 hover:bg-gray-100" %>

        <h2 class="text-lg font-semibold text-gray-900"><%= @month.strftime("%Y年%-m月") %></h2>

        <%= link_to "#{@month.next_month.strftime('%-m月')} ▶",
            settlements_path(month: @month.next_month.strftime("%Y-%m")),
            class: "rounded-lg border px-3 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
      </div>

      <p class="mt-4 text-center text-sm text-gray-500">支出の合計</p>
      <p class="text-center text-3xl font-bold text-gray-900">
        <%= number_to_currency(@monthly_total, unit: "¥", precision: 0) %>
      </p>

      <div class="mt-6 border-t pt-5">
        <%= render "shared/payer_totals", payer_totals: @payer_totals %>
      </div>
    </div>

    <!-- 精算額と、精算の状態 -->
    <div class="mt-6 rounded-xl bg-white p-4 shadow-sm sm:p-6">
      <% if @settlement.nil? %>
        <%# パートナーが未参加の世帯は、精算額を計算できない %>
        <p class="text-center text-sm text-gray-500">
          パートナーが参加すると精算できます。
          <%= link_to "招待コードを確認", household_path, class: "font-semibold text-blue-600 hover:underline" %>
        </p>
      <% else %>
        <div class="flex items-center justify-between">
          <p class="text-sm font-medium text-gray-500">精算額</p>
          <% if @settlement.persisted? %>
            <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">精算済み</span>
          <% end %>
        </div>

        <div class="mt-3 text-center">
          <% if @settlement.amount.zero? %>
            <p class="text-lg font-semibold text-gray-900">精算はありません(0円)</p>
            <p class="mt-1 text-sm text-gray-500">2人の負担額は同じです。</p>
          <% else %>
            <p class="text-gray-700">
              <span class="font-semibold"><%= @settlement.from_user.name %></span> さん
              →
              <span class="font-semibold"><%= @settlement.to_user.name %></span> さん
            </p>
            <p class="mt-1 text-3xl font-bold text-gray-900">
              <%= number_to_currency(@settlement.amount, unit: "¥", precision: 0) %>
            </p>
          <% end %>
        </div>

        <%# persisted? は DB に保存済みかどうか。find_by で見つかった記録なら true、計算しただけなら false %>
        <% if @settlement.persisted? %>
          <p class="mt-6 text-center text-xs text-gray-500">
            <%= @settlement.settled_at.strftime("%Y/%m/%d %H:%M") %> に精算済みにしました。
          </p>
        <% elsif @month >= Date.current.beginning_of_month %>
          <%# 当月・未来の月は、月が終わるまで精算できない(金額は現時点の見込み) %>
          <p class="mt-6 rounded-lg bg-gray-50 px-3 py-2 text-center text-sm text-gray-500">
            現時点の見込みです。<%= @month.strftime("%-m月") %>が終わってから精算できます。
          </p>
        <% else %>
          <%# 金額は送らず、月だけを送る。金額はサーバー側で計算し直す %>
          <%= button_to "精算済みにする", settlements_path, params: { month: @month.strftime("%Y-%m") },
              form: { data: { turbo_confirm: "#{@month.strftime('%-m月')}を精算済みにしますか？精算済みの月の支出は編集できなくなります。" } },
              class: "mt-6 w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700" %>
        <% end %>
      <% end %>
    </div>
  </main>
</div>
