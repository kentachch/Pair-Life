<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-6 sm:py-12">
  <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-lg sm:p-8">
    <h2 class="mb-8 text-center text-2xl font-bold text-gray-900">
      新規登録
    </h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-6">
        <!-- 名前 -->
        <div>
          <%= f.label :name, class: "mb-2 block text-sm font-medium text-gray-700" %>
          <%= f.text_field :name,
              autofocus: true,
              class: "block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" %>
        </div>

        <!-- メールアドレス -->
        <div>
          <%= f.label :email, class: "mb-2 block text-sm font-medium text-gray-700" %>
          <%= f.email_field :email,
              autocomplete: "email",
              class: "block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" %>
        </div>

        <!-- パスワード -->
        <div>
          <%= f.label :password, class: "mb-2 block text-sm font-medium text-gray-700" %>

          <% if @minimum_password_length %>
            <p class="mb-2 text-sm text-gray-500">
              <%= @minimum_password_length %>文字以上
            </p>
          <% end %>

          <%= f.password_field :password,
              autocomplete: "new-password",
              class: "block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" %>
        </div>

        <!-- パスワード確認 -->
        <div>
          <%= f.label :password_confirmation, class: "mb-2 block text-sm font-medium text-gray-700" %>
          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" %>
        </div>

        <!-- 登録ボタン -->
        <div>
          <%= f.submit "新規登録",
              class: "w-full rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
        </div>
      </div>
    <% end %>

    <div class="mt-6 border-t border-gray-200 pt-6 text-center text-sm">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
