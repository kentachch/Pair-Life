<div class="min-h-screen bg-gray-50">
  <main class="mx-auto max-w-6xl px-4 py-8">

    <!-- ページタイトル -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">
          家計一覧
        </h2>
        <p class="mt-1 text-sm text-gray-500">
          共同で管理している家計の支出を確認できます。
        </p>
      </div>

      <%= link_to "＋ 支出を追加",
          new_expense_path,
          class: "rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700" %>
    </div>

    <!-- カレンダーと円グラフ。広い画面では2列、スマホでは1列に並べる -->
    <div class="mb-8 grid gap-6 lg:grid-cols-2">
      <%= render "calendar", month: @month, daily_totals: @daily_totals %>

      <!-- 円グラフ。データは JavaScript(category_chart_controller.js)が API から取得して描く -->
      <div class="rounded-xl bg-white p-6 shadow-sm"
        data-controller="category-chart"
        data-category-chart-url-value="<%= api_category_totals_path(month: @month.strftime('%Y-%m')) %>">
        <h3 class="font-semibold text-gray-900">カテゴリ別の支出(<%= @month.strftime("%-m月") %>)</h3>

        <div class="mx-auto mt-4 max-w-xs">
          <canvas data-category-chart-target="canvas"></canvas>
          <p data-category-chart-target="empty" hidden class="py-8 text-center text-sm text-gray-500">
            今月の支出はまだありません。
          </p>
        </div>
      </div>
    </div>

    <!-- 最近の支出 -->
    <div class="overflow-hidden rounded-xl bg-white shadow-sm">

      <div class="flex items-center justify-between border-b px-6 py-4">
        <h3 class="font-semibold text-gray-900">最近の支出</h3>
        <%= link_to "すべて見る", expenses_path, class: "text-sm font-semibold text-blue-600 hover:underline" %>
      </div>

      <% if @recent_expenses.any? %>

        <div class="divide-y">
          <% @recent_expenses.each do |expense| %>
            <div class="flex items-center justify-between px-6 py-5">
              <div class="flex items-center gap-4">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100">
                  🍚
                </div>
                <div>
                  <p class="font-medium text-gray-900">
                    <%= expense.category.name %>
                  </p>
                  <p class="text-sm text-gray-500">
                    <%= expense.spent_on.strftime("%Y/%m/%d") %> ・ <%= expense.payer.name %>
                  </p>
                </div>
              </div>
              <!-- 金額 -->
              <p class="font-semibold text-gray-900">
                <%= number_to_currency(
                      expense.amount,
                      unit: "¥",
                      precision: 0
                    ) %>
              </p>
            </div>
          <% end %>
        </div>

      <% else %>

        <p class="px-6 py-8 text-center text-sm text-gray-500">
          まだ支出が登録されていません。
        </p>

      <% end %>

    </div>
  </main>
</div>
