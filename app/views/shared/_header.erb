<header class="border-b bg-white">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <%= link_to "共同家計管理アプリ",
                        root_path, 
                        class:"text-xl font-bold text-gray-900" %>

        <div class="flex items-center gap-4">
        <% if user_signed_in? %>
            <div class="flex items-center justify-end gap-6 p-4">
                <%= link_to "支出を管理", expenses_path, class: "text-md font-bold text-gray-900 hover:text-blue-600" %>
                <%= link_to "カテゴリを作る", categories_path, class: "text-md font-bold text-gray-900 hover:text-blue-600" %>
                <%= link_to "世帯メンバー", household_path, class: "text-md font-bold text-gray-900 hover:text-blue-600" %>
                <%= link_to "アカウント編集", edit_user_registration_path, class: "text-md font-bold text-gray-900 hover:text-blue-600" %>
                <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                    class: "rounded border px-3 py-1 hover:bg-gray-100" %>
            </div>
        <% end %>
        </div>
    </div>
</header>